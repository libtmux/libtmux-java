{
  "schemaVersion": 1,
  "examples": [
    {
      "id": "clojure-Connect",
      "variant": "clojure",
      "language": "clojure",
      "description": "Connect to a private tmux server.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/connect.clj",
      "mainNamespace": "libtmux.examples.api.connect",
      "targets": [
        "libtmux.core/open!",
        "libtmux.core/snapshot!"
      ],
      "expectedOutput": "connected=true\n",
      "path": "src/main/clojure/libtmux/examples/api/connect.clj"
    },
    {
      "id": "clojure-ListSessions",
      "variant": "clojure",
      "language": "clojure",
      "description": "List sessions from one capture.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/list_sessions.clj",
      "mainNamespace": "libtmux.examples.api.list-sessions",
      "targets": [
        "libtmux.core/sessions!"
      ],
      "expectedOutput": "sessions=work-one,work-two\n",
      "path": "src/main/clojure/libtmux/examples/api/list_sessions.clj"
    },
    {
      "id": "clojure-ListWindows",
      "variant": "clojure",
      "language": "clojure",
      "description": "Traverse root and session windows in one captured graph.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/list_windows.clj",
      "mainNamespace": "libtmux.examples.api.list-windows",
      "targets": [
        "libtmux.core/snapshot!",
        "libtmux.data/windows"
      ],
      "expectedOutput": "windows=editor,editor,logs\nsession-windows=editor,logs\n",
      "path": "src/main/clojure/libtmux/examples/api/list_windows.clj"
    },
    {
      "id": "clojure-ListPanes",
      "variant": "clojure",
      "language": "clojure",
      "description": "Traverse root, session, window and pane observations.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/list_panes.clj",
      "mainNamespace": "libtmux.examples.api.list-panes",
      "targets": [
        "libtmux.core/snapshot!",
        "libtmux.data/panes"
      ],
      "expectedOutput": "panes=4\nwindow-panes=2\n",
      "path": "src/main/clojure/libtmux/examples/api/list_panes.clj"
    },
    {
      "id": "clojure-NewSession",
      "variant": "clojure",
      "language": "clojure",
      "description": "Create a session running cat.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/new_session.clj",
      "mainNamespace": "libtmux.examples.api.new-session",
      "targets": [
        "libtmux.core/new-session!"
      ],
      "expectedOutput": "created=api-session\n",
      "path": "src/main/clojure/libtmux/examples/api/new_session.clj"
    },
    {
      "id": "clojure-NewWindow",
      "variant": "clojure",
      "language": "clojure",
      "description": "Create a detached window and refresh its parent.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/new_window.clj",
      "mainNamespace": "libtmux.examples.api.new-window",
      "targets": [
        "libtmux.core/new-window!",
        "libtmux.core/refresh!"
      ],
      "expectedOutput": "created=api-window\nwindows=api-window,editor,logs\n",
      "path": "src/main/clojure/libtmux/examples/api/new_window.clj"
    },
    {
      "id": "clojure-Query",
      "variant": "clojure",
      "language": "clojure",
      "description": "Evaluate native and Java predicates over the same capture.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/query.clj",
      "mainNamespace": "libtmux.examples.api.query",
      "targets": [
        "libtmux.data/matching",
        "libtmux.data/exactly-one"
      ],
      "expectedOutput": "matches=work-one\n",
      "path": "src/main/clojure/libtmux/examples/api/query.clj"
    },
    {
      "id": "clojure-Capture",
      "variant": "clojure",
      "language": "clojure",
      "description": "Send literal shell input and wait for actual output before capture.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/capture.clj",
      "mainNamespace": "libtmux.examples.api.capture",
      "targets": [
        "libtmux.core/send-literal!",
        "libtmux.core/send-keys!",
        "libtmux.core/await-text!",
        "libtmux.core/capture!"
      ],
      "expectedOutput": "api-keys\napi-line\n",
      "path": "src/main/clojure/libtmux/examples/api/capture.clj"
    },
    {
      "id": "clojure-Workspace",
      "variant": "clojure",
      "language": "clojure",
      "description": "Build a split layout, rename a window and follow its moved placement.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/workspace.clj",
      "mainNamespace": "libtmux.examples.api.workspace",
      "targets": [
        "libtmux.core/split-pane!",
        "libtmux.core/apply-layout!",
        "libtmux.core/rename!",
        "libtmux.core/move-window!",
        "libtmux.data/same-entity?",
        "libtmux.data/same-link?"
      ],
      "expectedOutput": "window=code panes=2\nsame-entity=true same-placement=false\n",
      "path": "src/main/clojure/libtmux/examples/api/workspace.clj"
    },
    {
      "id": "clojure-CaptureConcurrently",
      "variant": "clojure",
      "language": "clojure",
      "description": "Capture with bounded workers and cancel an owned wait after cleanup.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/capture_concurrently.clj",
      "mainNamespace": "libtmux.examples.api.capture-concurrently",
      "targets": [
        "libtmux.async/runtime!",
        "libtmux.async/submit!",
        "libtmux.async/cancel!",
        "libtmux.core/capture!",
        "libtmux.core/await-channel!"
      ],
      "expectedOutput": "captured=3\ncancelled=true cleaned=true\n",
      "path": "src/main/clojure/libtmux/examples/api/capture_concurrently.clj"
    },
    {
      "id": "clojure-WatchPaneOutput",
      "variant": "clojure",
      "language": "clojure",
      "description": "Read bounded UTF-8 output on an owned wait worker and inspect local termination.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/watch_pane_output.clj",
      "mainNamespace": "libtmux.examples.api.watch-pane-output",
      "targets": [
        "libtmux.async/submit!",
        "libtmux.control/attach!",
        "libtmux.control/subscribe!",
        "libtmux.control/next!",
        "libtmux.control/terminal",
        "libtmux.control/close!"
      ],
      "expectedOutput": "observed=stream-ready\nclosed=true\n",
      "path": "src/main/clojure/libtmux/examples/api/watch_pane_output.clj",
      "requiresControl": true,
      "unsupportedOutput": "requires tmux 3.7+\n"
    },
    {
      "id": "clojure-RunACommand",
      "variant": "clojure",
      "language": "clojure",
      "description": "Use a preserved Java Pane ref to read a command exit status and output.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/run_a_command.clj",
      "mainNamespace": "libtmux.examples.api.run-a-command",
      "targets": [
        "libtmux.core/new-session!",
        "libtmux.data/panes"
      ],
      "expectedOutput": "exit=3 output=built\n",
      "path": "src/main/clojure/libtmux/examples/api/run_a_command.clj"
    },
    {
      "id": "clojure-ObserveWithAsync",
      "variant": "clojure",
      "language": "clojure",
      "description": "Read bounded core.async events and stop without closing the borrowed connection.",
      "sourceFile": "examples/src/main/clojure/libtmux/examples/api/observe_with_async.clj",
      "mainNamespace": "libtmux.examples.api.observe-with-async",
      "targets": [
        "libtmux.core-async/observe!",
        "libtmux.core-async/events",
        "libtmux.core-async/terminal",
        "libtmux.control/send!"
      ],
      "expectedOutput": "observed=channel-ready\nadapter-stopped=true borrowed-open=true\n",
      "path": "src/main/clojure/libtmux/examples/api/observe_with_async.clj",
      "requiresControl": true,
      "unsupportedOutput": "requires tmux 3.7+\n",
      "cliAliases": [
        "core-async"
      ]
    }
  ],
  "variants": {
    "clojure": {
      "files": [
        {
          "sourceFile": "examples/api/clojure/deps.edn",
          "path": "deps.edn",
          "language": "clojure"
        },
        {
          "sourceFile": "examples/api/run.sh",
          "path": "run.sh",
          "language": "bash"
        }
      ]
    }
  }
}
