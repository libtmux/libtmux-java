{
  "schemaVersion": 1,
  "examples": [
    {
      "id": "java-Connect",
      "variant": "java",
      "language": "java",
      "description": "Connect to a private tmux server.",
      "sourceFile": "examples/src/main/java/io/github/libtmux/examples/api/java/Connect.java",
      "mainClass": "io.github.libtmux.examples.api.java.Connect",
      "targets": [
        "io.github.libtmux.Server",
        "io.github.libtmux.Server.open"
      ],
      "expectedOutput": "connected=true\n",
      "path": "src/main/java/Connect.java"
    },
    {
      "id": "java-ListSessions",
      "variant": "java",
      "language": "java",
      "description": "List the sessions returned by a server read.",
      "sourceFile": "examples/src/main/java/io/github/libtmux/examples/api/java/ListSessions.java",
      "mainClass": "io.github.libtmux.examples.api.java.ListSessions",
      "targets": [
        "io.github.libtmux.Server.sessions"
      ],
      "expectedOutput": "sessions=work-one,work-two\n",
      "path": "src/main/java/ListSessions.java"
    },
    {
      "id": "java-ListWindows",
      "variant": "java",
      "language": "java",
      "description": "List all windows, then the windows captured for one session.",
      "sourceFile": "examples/src/main/java/io/github/libtmux/examples/api/java/ListWindows.java",
      "mainClass": "io.github.libtmux.examples.api.java.ListWindows",
      "targets": [
        "io.github.libtmux.Server.windows",
        "io.github.libtmux.Session.windows"
      ],
      "expectedOutput": "windows=editor,editor,logs\nsession-windows=editor,logs\n",
      "path": "src/main/java/ListWindows.java"
    },
    {
      "id": "java-ListPanes",
