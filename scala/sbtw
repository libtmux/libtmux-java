#!/bin/sh
set -eu

build_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sbt_version=$(sed -n 's/^sbt.version=//p' "$build_dir/project/build.properties")
expected=$(cat "$build_dir/project/sbt-launch.sha256")
cache_dir=${LIBTMUX_SBT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/libtmux-sbt}
launcher=$cache_dir/sbt-launch-$sbt_version.jar

checksum() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
    else
        shasum -a 256 "$1" | cut -d ' ' -f 1
    fi
}

mkdir -p "$cache_dir"
if [ ! -f "$launcher" ]; then
    download=$(mktemp "$cache_dir/.sbt-launch.XXXXXXXX")
    trap 'rm -f "$download"' EXIT HUP INT TERM
    curl --fail --location --silent --show-error \
        --connect-timeout 10 \
        --max-time 120 \
        --output "$download" \
        "https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/$sbt_version/sbt-launch-$sbt_version.jar"
    if [ "$(checksum "$download")" != "$expected" ]; then
        echo 'sbt launcher checksum mismatch' >&2
        exit 1
    fi
    mv "$download" "$launcher"
    trap - EXIT HUP INT TERM
fi
if [ "$(checksum "$launcher")" != "$expected" ]; then
    echo 'Cached sbt launcher checksum mismatch; remove the damaged launcher.' >&2
    exit 1
fi

unset TMUX TMUX_PANE
cd "$build_dir"
java_command=${JAVA_HOME:+$JAVA_HOME/bin/}java
exec "$java_command" \
    -Xms256m \
    -Xmx2g \
    -XX:ActiveProcessorCount=4 \
    -Dsbt.supershell=false \
    -Dsbt.log.noformat=true \
    -Dsbt.repository.config="$build_dir/project/repositories" \
    -jar "$launcher" "$@"
