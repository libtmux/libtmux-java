root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches palantir-java-format, which Spotless enforces. An editor that disagreed would fight the
# formatter on every save.
[*.{java,kts,kt}]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing double-space is a line break in Markdown, so trimming it changes rendered output.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab

# Generated by Gradle; nothing here is edited by hand.
[gradlew*]
insert_final_newline = unset
trim_trailing_whitespace = unset
